{
  "id": "openclaw-argo-msgr",
  "name": "Argo Messenger",
  "description": "Argo Messenger channel plugin — OpenClaw connects to a company's Argo Messenger as a bot (like Telegram/Slack).",
  "channels": ["argo-msgr"],
  "contracts": { "tools": ["argo_request_approval"] },
  "configSchema": { "type": "object", "additionalProperties": false, "properties": {} },
  "channelConfigs": {
    "argo-msgr": {
      "label": "Argo Messenger",
      "description": "Company team messenger with AI agents (bot API)",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "url": { "type": "string" },
          "token": { "type": "string" },
          "enabled": { "type": "boolean" },
          "name": { "type": "string" },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": { "url": { "type": "string" }, "token": { "type": "string" }, "enabled": { "type": "boolean" }, "name": { "type": "string" } }
            }
          }
        }
      },
      "uiHints": { "url": { "label": "Server URL" }, "token": { "label": "Bot token", "sensitive": true } }
    }
  }
}
