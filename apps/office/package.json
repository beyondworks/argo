{
  "name": "argo-office",
  "version": "0.0.1",
  "private": true,
  "description": "Argo Office — 메일·페이지·메신저 업무 기록을 한 화면에 모으고 크루에게 일을 맡기는 웹 사무실(PWA)",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "dev": "npm run tokens && vite --port 5190 --strictPort",
    "build": "npm run tokens && vite build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-task-item": "^3.26.1",
    "@tiptap/extension-task-list": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
