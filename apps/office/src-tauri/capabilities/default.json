{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Office local window only; attachments require a native save dialog",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://*" }, { "url": "http://*" },
      { "url": "mailto:*" }, { "url": "tel:*" }
    ] }
  ]
}
