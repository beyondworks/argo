{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argo Office",
  "version": "0.1.0",
  "identifier": "com.beyondworks.argo.office",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5192 --strictPort",
    "devUrl": "http://localhost:5192",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "create": false, "title": "Argo Office",
      "width": 1280, "height": 840, "minWidth": 900, "minHeight": 600,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/office/32x32.png", "icons/office/128x128.png", "icons/office/128x128@2x.png", "icons/office/icon.icns", "icons/icon.ico"]
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["argo-office"] } } }
}
