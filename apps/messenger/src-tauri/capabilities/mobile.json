{
  "identifier": "mobile",
  "description": "Mobile login callback, push, haptics",
  "platforms": [
    "iOS",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "deep-link:default",
    "notification:default",
    "push-notifications:default",
    "core:window:allow-set-badge-count",
    "haptics:default",
    "core:webview:allow-set-webview-background-color"
  ]
}
