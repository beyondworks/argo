{
  "appId": "com.beyondworks.argo.mobile",
  "appName": "Argo",
  "webDir": "www",
  "server": {
    "allowNavigation": [
      "10.*.*.*",
      "192.168.*.*",
      "172.16.*.*",
      "172.17.*.*",
      "172.18.*.*",
      "172.19.*.*",
      "172.20.*.*",
      "172.21.*.*",
      "172.22.*.*",
      "172.23.*.*",
      "172.24.*.*",
      "172.25.*.*",
      "172.26.*.*",
      "172.27.*.*",
      "172.28.*.*",
      "172.29.*.*",
      "172.30.*.*",
      "172.31.*.*",
      "100.*.*.*",
      "10.*",
      "192.168.*",
      "172.16.*",
      "100.*",
      "*.ts.net",
      "*.*.ts.net",
      "127.0.0.1.nip.io"
    ],
    "cleartext": true
  },
  "ios": {
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": false,
    "packageManager": "SPM"
  },
  "android": {
    "allowMixedContent": true
  }
}
